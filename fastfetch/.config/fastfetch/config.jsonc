{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "data-raw",
        "source": "            __       / |\n            \\ \"-..--'_4|_\n _._____     \\ _  _(C \"._'._\n((^     '\"-._( O_ O \"._` '. \\\n `\"'--._     \\  y_     \\   \\|\n        '-._  \\_ _  __.=-.__,\\_\n            `'-(\" ,(\"___       \\,_____\n                (_,(\"___     .-./     '\n                |   C'___    (5)\n                /    ``  '---'-'._```\n               |     ```    |`    '\"-._\n               |    ````    \\-.`\n               |    ````    |  \"._ ``\n               /    ````    |     '-.__\n              |     ```     |\n              |     ```     |\n              |     ```     |\n              |     ```     /\n              |    ````    |\n              |    ```     |\n              |    ```     /\n              |    ```     |\n              /    ```     |\n             |     ```     |\n             |     ```     !\n             |     ```    / '-.___\n             |    ````    !_      ''-\n             /   `   `    | '--._____)\n             |     /|     !\n             !    / |     /\n             |    | |    /\n             |    | |   /\n             |    / |   |\n             /   /  |   |\n            /   /   |   |\n           (,,_]    (,_,)",
        "color": {
            "1": "#89b4fa",
            "2": "#89b4fa",
            "3": "#89b4fa",
            "4": "#89b4fa",
            "5": "#89b4fa",
            "6": "#89b4fa",
            "7": "#89b4fa",
            "8": "#89b4fa",
            "9": "#89b4fa"
        },
        "padding": {
            "top": 1,
            "left": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#89b4fa",
            "title": "#cdd6f4",
            "separator": "#6c7086"
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}",
            "color": {
                "user-name": "#cdd6f4",
                "at": "#6c7086",
                "host-name": "#89b4fa"
            }
        },
        {
            "type": "separator",
            "string": "──────"
        },
        {
            "type": "os",
            "key": "OS"
        },
        {
            "type": "break"
        },
        {
            "type": "kernel",
            "key": "KERNEL"
        },
        {
            "type": "break"
        },
        {
            "type": "uptime",
            "key": "UPTIME"
        },
        {
            "type": "break"
        },
        {
            "type": "packages",
            "key": "PKGS"
        },
        {
            "type": "break"
        },
        {
            "type": "shell",
            "key": "SHELL"
        },
        {
            "type": "break"
        },
        {
            "type": "terminal",
            "key": "TERM"
        },
        {
            "type": "break"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "break"
        },
        {
            "type": "display",
            "key": "DISPLAY"
        },
        {
            "type": "break"
        },
        {
            "type": "cursor",
            "key": "CURSOR"
        },
        {
            "type": "break"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "temp": true
        },
        {
            "type": "break"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        {
            "type": "break"
        },
        {
            "type": "memory",
            "key": "MEM"
        },
        {
            "type": "break"
        },
        {
            "type": "swap",
            "key": "SWAP"
        },
        {
            "type": "break"
        },
        {
            "type": "disk",
            "key": "DISK"
        },
        {
            "type": "break"
        },
        {
            "type": "localip",
            "key": "IP"
        },
        {
            "type": "break"
        },
        {
            "type": "battery",
            "key": "BATTERY"
        },
        {
            "type": "break"
        },
        {
            "type": "locale",
            "key": "LOCALE"
        },
        {
            "type": "break"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
