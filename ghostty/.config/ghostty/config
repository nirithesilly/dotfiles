# Прозрачность
background-opacity = 0.85

# Шрифт
font-family = JetBrainsMono Nerd Font
font-size = 11
font-style = Medium
font-style-bold = Bold
font-style-italic = Italic
font-style-bold-italic = Bold Italic

# Цвета (kitty default)
background = 000000
foreground = dddddd

# Нормальные цвета (palette 0-7)
palette = 0=#000000
palette = 1=#cc0403
palette = 2=#19cb00
palette = 3=#cecb00
palette = 4=#0d73cc
palette = 5=#cb1ed1
palette = 6=#0dcdcd
palette = 7=#dddddd

# Яркие цвета (palette 8-15)
palette = 8=#767676
palette = 9=#f2201f
palette = 10=#23fd00
palette = 11=#fffd00
palette = 12=#1a8fff
palette = 13=#fd28ff
palette = 14=#14ffff
palette = 15=#ffffff

# Выделение
selection-foreground = 000000
selection-background = #fffacd

# Курсор
cursor-style = block
cursor-style-blink = false

# Отключаем shell integration, т.к. она конфликтует с ble.sh (двойной prompt)
shell-integration = none

# Не спрашивать подтверждение при закрытии окна/вкладки
confirm-close-surface = false
