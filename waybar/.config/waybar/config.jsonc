{
    "layer": "top",
    "position": "top",
    "height": 34,

    "modules-left": [
        "niri/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "niri/language",
        "pulseaudio",
        "network",
        "cpu",
        "temperature",
        "memory",
        "battery",
        "backlight",
        "tray"
    ],

    "niri/workspaces": {
        "format": "{icon}"
    },

    "niri/language": {
        "format": "{}"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-"
    },

    "network": {
        "format-wifi": "󰤨",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤮",
        "on-click": "alacritty -e nmtui",
        "tooltip-format": "{ifname}: {ipaddr} ({essid})"
    },

    "cpu": {
        "format": "󰋪 {usage}%",
        "on-click": "alacritty -e btop"
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon3/temp1_input",
        "format": "󰵏 {temperatureC}°C",
        "interval": 5,
        "tooltip": true
    },

    "memory": {
        "format": "󰍛 {}%",
        "on-click": "alacritty -e btop"
    },

    "battery": {
        "format-charging": "󰲄 {capacity}%",
        "format-plugged": "󰲄 {capacity}%",
        "format-discharging": "{icon} {capacity}%",
        "format-icons": [
            "󰁺",
            "󰁻",
            "󰁼",
            "󰁽",
            "󰁾",
            "󰁿",
            "󰂀",
            "󰂁",
            "󰂂",
            "󰁹"
        ],
        "interval": 30,
        "tooltip": true
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": [
            "󰃚",
            "󰃛",
            "󰃜",
            "󰃝"
        ],
        "on-scroll-up": "brightnessctl -d intel_backlight set +5%",
        "on-scroll-down": "brightnessctl -d intel_backlight set 5%-"
    },

    "tray": {
        "spacing": 8
    }
}